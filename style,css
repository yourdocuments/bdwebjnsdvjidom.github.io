  }

  .hero h1 {
    margin-top: 20px;
    font-size: clamp(38px, 10vw, 52px);
    letter-spacing: -1.4px;
  }

  .hero-description {
    margin-top: 17px;
    font-size: 13px;
    line-height: 1.9;
  }

  .hero-actions {
    gap: 9px;
    margin-top: 23px;
  }

  .button-large {
    min-height: 46px;
    padding: 12px 14px;
    font-size: 11px;
  }

  .hero-trust {
    margin-top: 25px;
  }

  .hero-visual {
    min-height: 390px;
    margin-top: 10px;
  }

  .preview-main {
    width: 83%;
  }

  .preview-site {
    min-height: 305px;
  }

  .preview-site-nav {
    padding: 14px 16px;
  }

  .preview-site-hero {
    padding: 20px 17px 12px;
  }

  .mini-headline {
    font-size: 34px;
  }

  .preview-site-image {
    height: 130px;
  }

  .preview-secondary {
    right: -1%;
    bottom: 2%;
    width: 125px;
  }

  .secondary-cover {
    height: 75px;
  }

  .floating-label {
    gap: 6px;
    padding: 8px 10px;
    font-size: 9px;
  }

  .floating-label-top {
    top: 1%;
    right: 0;
  }

  .floating-label-bottom {
    bottom: 7%;
    left: -1%;
  }

  .floating-label-bottom strong {
    font-size: 9px;
  }

  .floating-label-bottom small {
    font-size: 8px;
  }

  .floating-check {
    width: 24px;
    height: 24px;
  }

  .hero-visual-caption {
    right: 0;
    bottom: -12px;
    font-size: 7px;
    letter-spacing: .9px;
  }

  .hero-bottom-line {
    bottom: 23px;
    font-size: 7px;
    letter-spacing: .7px;
  }

  .hero-bottom-line a {
    font-size: 10px;
  }

  .trust-strip-inner > span {
    font-size: 11px;
  }

  .trust-pills {
    gap: 7px;
  }

  .trust-pills span {
    padding: 6px 8px;
    font-size: 9px;
  }

  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 28px;
  }

  .section-heading h2,
  .pricing-intro h2 {
    font-size: clamp(32px, 8vw, 42px);
  }

  .section-heading > p {
    font-size: 12px;
  }

  .category-grid {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .category-card {
    min-height: 235px;
    padding: 22px;
  }

  .category-card h3 {
    margin-top: 18px;
    font-size: 18px;
  }

  .category-card p {
    font-size: 12px;
  }

  .website-filters {
    gap: 7px;
  }

  .filter-button {
    padding: 8px 11px;
    font-size: 10px;
  }

  .website-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }

  .website-card:last-child {
