/* =========================================================
   WEBSITESDEAL BANGLADESH
   Premium Dark + Green Motion Design
   Compatible with the accompanying script.js
   ========================================================= */

:root {
  --bg: #07110d;
  --bg-soft: #0a1510;
  --panel: #0d1a14;
  --panel-2: #122219;
  --panel-3: #192d20;

  --green: #b7f34a;
  --green-2: #8ed52e;
  --green-glow: rgba(183, 243, 74, 0.16);

  --text: #f2f7f1;
  --muted: #a0b1a4;
  --border: rgba(219, 242, 222, 0.1);
  --border-green: rgba(183, 243, 74, 0.25);

  --danger: #ff7272;
  --white: #ffffff;

  --container: 1320px;
  --radius-sm: 10px;
  --radius: 16px;
  --radius-lg: 24px;
  --radius-xl: 32px;

  --shadow: 0 18px 55px rgba(0, 0, 0, 0.22);
  --shadow-green: 0 12px 35px rgba(142, 213, 46, 0.12);

  --ease: cubic-bezier(.22, 1, .36, 1);
  --transition: 300ms var(--ease);
}

/* ================ RESET ================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, "Plus Jakarta Sans", system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 15px;
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

body,
button,
input,
select,
textarea {
  font-family: Inter, "Plus Jakarta Sans", system-ui, sans-serif;
}

img,
picture,
video,
svg {
  max-width: 100%;
}

img {
  display: block;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 4px;
}

::selection {
  color: var(--bg);
  background: var(--green);
}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  background: #304634;
  border: 2px solid var(--bg);
  border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--green-2);
}

/* ================ PAGE MOTION ================ */

html:not(.motion-ready) .reveal,
html:not(.motion-ready) .reveal-up,
html:not(.motion-ready) .fade-in,
html:not(.motion-ready) .category-card,
html:not(.motion-ready) .product-card,
html:not(.motion-ready) .website-card,
html:not(.motion-ready) .pricing-card,
html:not(.motion-ready) .feature-card,
html:not(.motion-ready) .testimonial-card {
  opacity: 1;
  transform: none;
}

.motion-ready .reveal,
.motion-ready .reveal-up,
.motion-ready .fade-in,
.motion-ready .category-card,
.motion-ready .product-card,
.motion-ready .website-card,
.motion-ready .pricing-card,
.motion-ready .feature-card,
.motion-ready .testimonial-card {
  opacity: 0;
  transform: translate3d(0, 24px, 0);
  transition:
    opacity 700ms var(--ease),
    transform 700ms var(--ease);
  transition-delay: var(--reveal-delay, 0ms);
}

.motion-ready .reveal.is-visible,
.motion-ready .reveal-up.is-visible,
.motion-ready .fade-in.is-visible,
.motion-ready .category-card.is-visible,
.motion-ready .product-card.is-visible,
.motion-ready .website-card.is-visible,
.motion-ready .pricing-card.is-visible,
.motion-ready .feature-card.is-visible,
.motion-ready .testimonial-card.is-visible {
  opacity: 1;
  transform: translate3d(0, 0, 0);
}

.reveal-left {
  transform: translate3d(-30px, 0, 0);
}

.reveal-right {
  transform: translate3d(30px, 0, 0);
}

.reveal-scale {
  transform: scale(.96);
}

.is-visible.reveal-left,
.is-visible.reveal-right,
.is-visible.reveal-scale {
  transform: none;
}

@keyframes wdFadeUp {
  from {
    opacity: 0;
    transform: translateY(22px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes wdFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes wdFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}

@keyframes wdPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(183, 243, 74, 0); }
  50% { box-shadow: 0 0 0 9px rgba(183, 243, 74, .06); }
}

@keyframes wdShimmer {
  from { background-position: 180% 0; }
  to { background-position: -180% 0; }
}

@keyframes wdSpin {
  to { transform: rotate(360deg); }
}

@keyframes wdSlideIn {
  from {
    opacity: 0;
    transform: translateY(-12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes wdGlow {
  0%, 100% { opacity: .45; }
  50% { opacity: .8; }
}

/* ================ COMMON LAYOUT ================ */

.container,
.wrapper,
.section-container {
  width: min(var(--container), calc(100% - 48px));
  margin-inline: auto;
}

section {
  position: relative;
}

.section {
  padding-block: 100px;
}

.section-sm {
  padding-block: 64px;
}

.section-heading {
  max-width: 760px;
  margin: 0 auto 48px;
  text-align: center;
}

.section-heading h2,
.section-title {
  margin: 0 0 16px;
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -1.7px;
}

.section-heading p,
.section-description {
  margin: 0;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.85;
}

.eyebrow,
.section-label,
.badge-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  color: var(--green);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.8px;
  text-transform: uppercase;
}

.eyebrow::before {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 14px rgba(183, 243, 74, .55);
  content: "";
}

.text-green,
.highlight {
  color: var(--green);
}

.muted {
  color: var(--muted);
}

.gradient-text {
  color: var(--green);
  background: linear-gradient(110deg, #d9ffa0, var(--green), #83ce38);
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.divider {
  height: 1px;
  background: var(--border);
}

.glass {
  background: rgba(13, 26, 20, .78);
  border: 1px solid var(--border);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

/* ================ TOP ANNOUNCEMENT BAR ================ */

.top-bar,
.announcement-bar {
  position: relative;
  z-index: 1001;
  display: flex;
  min-height: 38px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 7px 20px;
  color: #dcebdc;
  background: #0b1710;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  text-align: center;
}

.top-bar a,
.announcement-bar a {
  color: var(--green);
  font-weight: 700;
}

/* ================ HEADER & NAVIGATION ================ */

header,
.site-header,
.navbar,
.main-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  background: rgba(7, 17, 13, .84);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  transition:
    background var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

header.is-scrolled,
.site-header.is-scrolled,
.navbar.is-scrolled,
.main-header.is-scrolled {
  background: rgba(7, 17, 13, .96);
  border-bottom-color: var(--border-green);
  box-shadow: 0 12px 35px rgba(0, 0, 0, .2);
}

.nav-container,
.nav-inner,
.header-inner {
  display: flex;
  width: min(var(--container), calc(100% - 48px));
  min-height: 78px;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  margin-inline: auto;
}

.logo,
.brand,
.site-logo {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 10px;
  color: var(--text);
  font-size: 22px;
  font-weight: 850;
  letter-spacing: -.8px;
}

.logo img,
.brand img,
.site-logo img {
  width: auto;
  max-width: 180px;
  max-height: 46px;
  object-fit: contain;
}

.nav-links,
.nav-menu,
header nav ul {
  display: flex;
  align-items: center;
  gap: 26px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-links a,
.nav-menu a,
header nav ul a {
  position: relative;
  color: #c5d2c7;
  font-size: 13px;
  font-weight: 600;
  transition: color var(--transition);
}

.nav-links a::after,
.nav-menu a::after {
  position: absolute;
  right: 0;
  bottom: -8px;
  left: 0;
  height: 2px;
  background: var(--green);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition);
  content: "";
}

.nav-links a:hover,
.nav-menu a:hover,
header nav ul a:hover {
  color: var(--green);
}

.nav-links a:hover::after,
.nav-menu a:hover::after {
  transform: scaleX(1);
}

.nav-actions,
.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.menu-toggle,
.mobile-menu-toggle,
#menuToggle,
#mobileMenuToggle {
  display: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  cursor: pointer;
  transition: border-color var(--transition), background var(--transition);
}

.menu-toggle:hover,
.mobile-menu-toggle:hover,
#menuToggle:hover,
#mobileMenuToggle:hover {
  border-color: var(--border-green);
  background: var(--panel-2);
}

.mobile-menu,
.nav-links.is-open {
  animation: wdSlideIn 240ms var(--ease) both;
}

/* ================ BUTTONS ================ */

.btn,
.button,
button.btn,
a.button {
  position: relative;
  display: inline-flex;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 20px;
  overflow: hidden;
  border: 1px solid transparent;
  border-radius: 12px;
  background: var(--green);
  color: #14210b;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
  cursor: pointer;
  transition:
    transform 250ms var(--ease),
    background var(--transition),
    border-color var(--transition),
    box-shadow var(--transition);
}

.btn::before,
.button::before {
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent 20%, rgba(255,255,255,.24), transparent 80%);
  transform: translateX(-120%);
  transition: transform 650ms var(--ease);
  content: "";
  pointer-events: none;
}

.btn:hover::before,
.button:hover::before {
  transform: translateX(120%);
}

.btn:hover,
.button:hover {
  background: #c8ff67;
  box-shadow: var(--shadow-green);
  transform: translateY(-2px);
}

.btn:active,
.button:active {
  transform: translateY(0) scale(.98);
}

.btn-outline,
.button-outline,
.btn-secondary {
  border-color: var(--border-green);
  background: transparent;
  color: var(--text);
}

.btn-outline:hover,
.button-outline:hover,
.btn-secondary:hover {
  border-color: var(--green);
  background: rgba(183, 243, 74, .07);
  color: var(--green);
}

.btn-dark {
  border-color: var(--border);
  background: var(--panel-2);
  color: var(--text);
}

.btn-dark:hover {
  border-color: var(--border-green);
  background: var(--panel-3);
}

.btn-sm {
  min-height: 36px;
  padding: 8px 13px;
  border-radius: 9px;
  font-size: 12px;
}

.btn-lg {
  min-height: 54px;
  padding: 15px 26px;
  border-radius: 14px;
  font-size: 14px;
}

.btn-block {
  width: 100%;
}

/* ================ HERO SECTION ================ */

.hero,
.hero-section {
  position: relative;
  isolation: isolate;
  padding-block: clamp(75px, 10vw, 130px) 95px;
  overflow: hidden;
}

.hero::before,
.hero-section::before {
  position: absolute;
  z-index: -1;
  top: -170px;
  right: -130px;
  width: 650px;
  height: 650px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(142, 213, 46, .12), transparent 68%);
  animation: wdGlow 7s ease-in-out infinite;
  content: "";
  pointer-events: none;
}

.hero::after,
.hero-section::after {
  position: absolute;
  z-index: -1;
  bottom: -240px;
  left: -160px;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(70, 133, 71, .1), transparent 70%);
  content: "";
  pointer-events: none;
}

.hero-grid,
.hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(40px, 6vw, 90px);
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero h1,
.hero-title,
.hero-content h1 {
  margin: 0 0 24px;
  font-size: clamp(40px, 5.5vw, 70px);
  font-weight: 850;
  line-height: 1.06;
  letter-spacing: -3.2px;
}

.hero p,
.hero-description,
.hero-content > p {
  max-width: 600px;
  margin: 0 0 28px;
  color: var(--muted);
  font-size: clamp(15px, 1.4vw, 17px);
  line-height: 1.9;
}

.hero-actions,
.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.hero-note {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-top: 24px;
  color: var(--muted);
  font-size: 12px;
}

.hero-note span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.hero-note span::before {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  content: "";
}

.hero-visual,
.hero-image,
.hero-dashboard,
.hero-preview {
  position: relative;
  min-width: 0;
  transform-origin: center;
  will-change: transform;
}

.hero-visual img,
.hero-image img {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow);
}

.hero-dashboard,
.hero-preview {
  padding: 20px;
  border: 1px solid var(--border-green);
  border-radius: var(--radius-xl);
  background: linear-gradient(145deg, #14251a, #0b1710);
  box-shadow: 0 30px 90px rgba(0, 0, 0, .32);
}

.hero-float,
.floating-card {
  animation: wdFloat 5s ease-in-out infinite;
}

.hero-float:nth-child(2),
.floating-card:nth-child(2) {
  animation-delay: -2s;
}

/* ================ TRUST / STATS ================ */

.trust-bar,
.trusted-by,
.stats-section {
  padding-block: 30px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(13, 26, 20, .55);
}

.trust-inner,
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
}

.stat-item,
.trust-item {
  padding: 10px;
  text-align: center;
}

.stat-number,
.stat-value,
.counter {
  display: block;
  color: var(--green);
  font-size: clamp(26px, 3vw, 38px);
  font-weight: 850;
  line-height: 1.2;
  letter-spacing: -1px;
}

.stat-label,
.stat-item p {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* ================ CATEGORY CARDS ================ */

.categories-section,
.category-section {
  padding-block: 90px;
}

.category-grid,
.categories-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.category-card,
.category-item {
  position: relative;
  display: flex;
  min-height: 170px;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding: 24px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(145deg, var(--panel), #0a1510);
  transition:
    border-color var(--transition),
    background var(--transition),
    box-shadow var(--transition),
    transform var(--transition);
}

.category-card::after,
.category-item::after {
  position: absolute;
  right: -45px;
  bottom: -65px;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: var(--green-glow);
  filter: blur(25px);
  opacity: 0;
  transition: opacity var(--transition);
  content: "";
  pointer-events: none;
}

.category-card:hover,
.category-item:hover {
  border-color: var(--border-green);
  background: linear-gradient(145deg, #15261a, #0d1a12);
  box-shadow: var(--shadow-green);
  transform: translateY(-5px);
}

.category-card:hover::after,
.category-item:hover::after {
  opacity: 1;
}

.category-icon,
.category-card .icon {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  border: 1px solid var(--border-green);
  border-radius: 14px;
  background: rgba(183, 243, 74, .08);
  color: var(--green);
  font-size: 22px;
  transition: transform var(--transition), background var(--transition);
}

.category-card:hover .category-icon,
.category-card:hover .icon {
  background: rgba(183, 243, 74, .16);
  transform: scale(1.08) rotate(-3deg);
}

.category-card h3,
.category-item h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 750;
}

.category-card p,
.category-item p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
}

/* ================ WEBSITE LISTINGS ================ */

.website-grid,
.product-grid,
.products-grid,
.marketplace-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.website-card,
.product-card,
.listing-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--panel);
  transition:
    border-color var(--transition),
    box-shadow var(--transition),
    transform var(--transition);
}

.website-card:hover,
.product-card:hover,
.listing-card:hover,
.website-card.is-hovered,
.product-card.is-hovered {
  border-color: var(--border-green);
  box-shadow: var(--shadow);
  transform: translateY(-6px);
}

.website-image,
.product-image,
.listing-image {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--panel-2);
}

.website-image img,
.product-image img,
.listing-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 700ms var(--ease);
}

.website-card:hover .website-image img,
.product-card:hover .product-image img,
.listing-card:hover .listing-image img {
  transform: scale(1.055);
}

.website-info,
.product-info,
.listing-info {
  padding: 22px;
}

.website-info h3,
.product-info h3,
.listing-info h3 {
  margin: 0 0 8px;
  font-size: 18px;
  font-weight: 800;
  line-height: 1.4;
}

.website-info p,
.product-info p,
.listing-info p {
  margin: 0 0 16px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.8;
}

.website-meta,
.product-meta,
.listing-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 18px;
}

.tag,
.pill,
.category-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border: 1px solid var(--border);
  border-radius: 100px;
  background: rgba(255, 255, 255, .025);
  color: #c8d7cb;
  font-size: 11px;
  font-weight: 700;
}

.tag-green,
.pill-green {
  border-color: var(--border-green);
  background: rgba(183, 243, 74, .08);
  color: var(--green);
}

.website-price,
.product-price,
.price {
  color: var(--green);
  font-size: 23px;
  font-weight: 850;
  letter-spacing: -.6px;
}

.price-old {
  margin-left: 8px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
  text-decoration: line-through;
}

.website-footer,
.product-footer,
.listing-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid var(--border);
}

/* ================ PRICING / SUBSCRIPTION ================ */

.pricing-section {
  padding-block: 100px;
  background:
    radial-gradient(ellipse at 50% 0, rgba(142, 213, 46, .07), transparent 60%),
    var(--bg-soft);
}

.pricing-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 22px;
}

.pricing-card {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: linear-gradient(150deg, #101e15, #0b1510);
  transition:
    border-color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);
}

.pricing-card:hover {
  border-color: var(--border-green);
  box-shadow: var(--shadow-green);
  transform: translateY(-5px);
}

.pricing-card.featured,
.pricing-card.popular {
  border-color: var(--green);
  background:
    radial-gradient(ellipse at 50% 0, rgba(183, 243, 74, .1), transparent 65%),
    linear-gradient(150deg, #14251a, #0b1510);
  box-shadow: 0 0 0 1px rgba(183, 243, 74, .05);
}

.popular-label,
.pricing-badge {
  position: absolute;
  top: 18px;
  right: 18px;
  padding: 6px 11px;
  border-radius: 100px;
  background: var(--green);
  color: #15210c;
  font-size: 10px;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: .6px;
}

.pricing-card h3 {
  margin: 0 0 8px;
  font-size: 21px;
}

.pricing-card > p {
  margin: 0 0 20px;
  color: var(--muted);
  font-size: 13px;
}

.pricing-price {
  margin-block: 10px 20px;
  color: var(--green);
  font-size: clamp(32px, 4vw, 42px);
  font-weight: 850;
  letter-spacing: -1.8px;
}

.pricing-price small {
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0;
}

.pricing-features,
.feature-list {
  display: grid;
  gap: 12px;
  margin: 0 0 26px;
  padding: 0;
  list-style: none;
}

.pricing-features li,
.feature-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: #d2ded4;
  font-size: 13px;
}

.pricing-features li::before,
.feature-list li::before {
  flex: 0 0 auto;
  color: var(--green);
  font-weight: 900;
  content: "✓";
}

.pricing-card .btn {
  width: 100%;
  margin-top: auto;
}

.billing-toggle,
[data-billing-toggle] {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 8px 14px;
  border: 1px solid var(--border);
  border-radius: 100px;
  background: var(--panel);
  color: var(--text);
  font-size: 12px;
}

/* ================ FEATURES ================ */

.features-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.feature-card {
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  transition:
    border-color var(--transition),
    transform var(--transition),
    background var(--transition);
}

.feature-card:hover {
  border-color: var(--border-green);
  background: var(--panel-2);
  transform: translateY(-4px);
}

.feature-card h3 {
  margin: 18px 0 8px;
  font-size: 17px;
}

.feature-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.85;
}

/* ================ TESTIMONIALS ================ */

.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.testimonial-card {
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--panel);
  transition: border-color var(--transition), transform var(--transition);
}

.testimonial-card:hover {
  border-color: var(--border-green);
  transform: translateY(-4px);
}

.testimonial-card blockquote {
  margin: 0 0 22px;
  color: #d7e2d8;
  font-size: 14px;
  line-height: 1.9;
}

.testimonial-author {
  display: flex;
  align-items: center;
  gap: 12px;
}

.testimonial-author img,
.avatar {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  border-radius: 50%;
  object-fit: cover;
}

.testimonial-author strong {
  display: block;
  font-size: 13px;
}

.testimonial-author span {
  display: block;
  color: var(--muted);
  font-size: 11px;
}

/* ================ SEARCH / FILTERS ================ */

.search-box {
  display: flex;
  min-height: 54px;
  align-items: center;
  gap: 12px;
  padding: 0 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--panel);
  transition: border-color var(--transition), box-shadow var(--transition);
}

.search-box:focus-within {
  border-color: var(--green);
  box-shadow: 0 0 0 4px rgba(183, 243, 74, .07);
}

.search-box input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
}

.search-box input::placeholder {
  color: #788b7c;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-block: 24px;
}

.filter-chip {
  padding: 9px 14px;
  border: 1px solid var(--border);
  border-radius: 100px;
  background: var(--panel);
  color: #c5d3c7;
  font-size: 12px;
  cursor: pointer;
  transition: all var(--transition);
}

.filter-chip:hover,
.filter-chip.active {
  border-color: var(--green);
  background: rgba(183, 243, 74, .09);
  color: var(--green);
}

/* ================ FORMS / NEWSLETTER ================ */

.form-group {
  display: grid;
  gap: 8px;
  margin-bottom: 18px;
}

label {
  color: #d6e2d8;
  font-size: 12px;
  font-weight: 700;
}

input,
select,
textarea {
  width: 100%;
  min-height: 46px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: #0a1510;
  color: var(--text);
  transition: border-color var(--transition), box-shadow var(--transition);
}

input::placeholder,
textarea::placeholder {
  color: #7d9182;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--green);
  outline: 0;
  box-shadow: 0 0 0 4px rgba(183, 243, 74, .06);
}

textarea {
  min-height: 120px;
  resize: vertical;
}

select {
  cursor: pointer;
}

.newsletter-form {
  display: flex;
  gap: 10px;
}

.newsletter-form input {
  flex: 1;
  min-width: 0;
}

.form-message,
.newsletter-message {
  margin-top: 10px;
  color: var(--green);
  font-size: 12px;
}

/* ================ CTA ================ */

.cta-section {
  padding-block: 80px;
}

.cta-box {
  position: relative;
  padding: clamp(30px, 6vw, 70px);
  overflow: hidden;
  border: 1px solid var(--border-green);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(ellipse at 100% 0, rgba(183, 243, 74, .12), transparent 45%),
    linear-gradient(130deg, #14251a, #0b1510);
  text-align: center;
}

.cta-box h2 {
  max-width: 760px;
  margin: 0 auto 18px;
  font-size: clamp(30px, 4.5vw, 48px);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -1.6px;
}

.cta-box p {
  max-width: 620px;
  margin: 0 auto 26px;
  color: var(--muted);
}

.cta-box .btn {
  margin-inline: 5px;
}

/* ================ FOOTER ================ */

footer,
.site-footer,
.main-footer {
  padding-top: 65px;
  border-top: 1px solid var(--border);
  background: #060e09;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr repeat(3, minmax(0, 1fr));
  gap: 45px;
  padding-bottom: 45px;
}

.footer-brand p {
  max-width: 330px;
  margin: 18px 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.9;
}

.footer-column h4 {
  margin: 0 0 18px;
  color: var(--text);
  font-size: 13px;
}

.footer-column ul {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.footer-column a,
.footer-links a {
  color: var(--muted);
  font-size: 12px;
  transition: color var(--transition);
}

.footer-column a:hover,
.footer-links a:hover {
  color: var(--green);
}

.footer-bottom {
  display: flex;
  min-height: 68px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-top: 1px solid var(--border);
  color: var(--muted);
  font-size: 11px;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

/* ================ SCROLL PROGRESS ================ */

#scrollProgress,
.scroll-progress,
.scroll-progress-bar {
  position: fixed;
  z-index: 2000;
  top: 0;
  left: 0;
  width: 0;
  height: 3px;
  border: 0;
  border-radius: 0 3px 3px 0;
  background: linear-gradient(90deg, var(--green-2), #d8ff92);
  box-shadow: 0 0 12px rgba(183, 243, 74, .35);
  pointer-events: none;
}

/* ================ BACK TO TOP ================ */

#backToTop,
.back-to-top {
  position: fixed;
  z-index: 900;
  right: 24px;
  bottom: 24px;
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border: 1px solid var(--border-green);
  border-radius: 14px;
  background: #14251a;
  color: var(--green);
  box-shadow: var(--shadow);
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all var(--transition);
}

#backToTop.visible,
#backToTop.is-visible,
.back-to-top.visible,
.back-to-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

#backToTop:hover,
.back-to-top:hover {
  background: var(--green);
  color: var(--bg);
  transform: translateY(-4px);
}

/* ================ BADGES / ALERTS ================ */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 8px;
  background: rgba(183, 243, 74, .1);
  color: var(--green);
  font-size: 11px;
  font-weight: 750;
}

.alert {
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  color: var(--muted);
  font-size: 13px;
}

.alert-success {
  border-color: rgba(183, 243, 74, .25);
  color: var(--green);
}

.alert-error {
  border-color: rgba(255, 114, 114, .3);
  color: var(--danger);
}

/* ================ LOADING / PLACEHOLDER ================ */

.skeleton {
  border-radius: 10px;
  background: linear-gradient(
    90deg,
    #101e15 25%,
    #1a2b1d 45%,
    #101e15 65%
  );
  background-size: 250% 100%;
  animation: wdShimmer 1.8s linear infinite;
}

.loading-spinner {
  width: 22px;
  height: 22px;
  border: 2px solid rgba(183, 243, 74, .2);
  border-top-color: var(--green);
  border-radius: 50%;
  animation: wdSpin 700ms linear infinite;
}

/* ================ LIGHT THEME SUPPORT ================ */

html[data-theme="light"],
body[data-theme="light"],
.light-theme {
  --bg: #f6f9f5;
  --bg-soft: #eef4ed;
  --panel: #ffffff;
  --panel-2: #f0f6ef;
  --panel-3: #e6f0e2;

  --text: #17231a;
  --muted: #607063;
  --border: rgba(20, 45, 24, .12);
  --border-green: rgba(90, 145, 35, .35);
  --green: #6da92b;
  --green-2: #8ed52e;
  --green-glow: rgba(109, 169, 43, .12);

  color: var(--text);
  background: var(--bg);
}

html[data-theme="light"] header,
html[data-theme="light"] .site-header,
html[data-theme="light"] .navbar,
body[data-theme="light"] header,
body[data-theme="light"] .site-header,
body[data-theme="light"] .navbar {
  background: rgba(255, 255, 255, .9);
}

html[data-theme="light"] .hero-dashboard,
html[data-theme="light"] .hero-preview,
html[data-theme="light"] .pricing-card,
html[data-theme="light"] .website-card,
html[data-theme="light"] .product-card,
html[data-theme="light"] .category-card,
html[data-theme="light"] .feature-card,
html[data-theme="light"] .testimonial-card {
  background-color: var(--panel);
}

html[data-theme="light"] input,
html[data-theme="light"] select,
html[data-theme="light"] textarea {
  background: #fff;
  color: var(--text);
}

html[data-theme="light"] footer,
html[data-theme="light"] .site-footer,
html[data-theme="light"] .main-footer {
  background: #edf4eb;
}

/* ================ RESPONSIVE ================ */

@media (max-width: 1100px) {
  .nav-links,
