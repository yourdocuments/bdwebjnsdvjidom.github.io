/* =========================================================
   WebsitesDeal Bangladesh — Premium Style
   Step 1.1.4 | style.css
   ========================================================= */

:root {
  --bg: #07110d;
  --bg-soft: #0a1510;
  --panel: #0d1a13;
  --panel-2: #112118;
  --panel-3: #17291e;
  --green: #b7f34a;
  --green-2: #8ed52e;
  --green-soft: rgba(183, 243, 74, .11);
  --text: #f2f7f0;
  --muted: #a1b0a4;
  --muted-2: #718376;
  --border: rgba(220, 245, 224, .10);
  --border-green: rgba(183, 243, 74, .28);
  --radius: 18px;
  --radius-lg: 26px;
  --max-width: 1320px;
  --header-height: 82px;
  --ease: cubic-bezier(.22, 1, .36, 1);
  --shadow: 0 25px 80px rgba(0, 0, 0, .25);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-family: "Hind Siliguri", "Inter", sans-serif;
  font-size: 15px;
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  transition: background .3s ease, color .3s ease;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: .22;
  background-image: radial-gradient(rgba(200, 230, 200, .18) .6px, transparent .6px);
  background-size: 22px 22px;
}

body.menu-open {
  overflow: hidden;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  color: inherit;
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button:focus-visible,
a:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 4px;
}

img {
  display: block;
  max-width: 100%;
}

::selection {
  background: var(--green);
  color: #07110d;
}

.section-shell {
  width: min(var(--max-width), calc(100% - 64px));
  margin-inline: auto;
}

.section-block {
  padding-top: 112px;
  padding-bottom: 112px;
}

/* Announcement */

.announcement-bar {
  min-height: 37px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  padding: 7px 20px;
  background: #101e14;
  color: #c4d4c5;
  border-bottom: 1px solid var(--border);
  font-size: 12px;
  text-align: center;
}

.announcement-dot,
.status-indicator {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px rgba(183, 243, 74, .6);
}

.announcement-bar a {
  margin-left: 8px;
  color: var(--green);
  font-weight: 700;
  white-space: nowrap;
}

.announcement-bar a span {
  display: inline-block;
  transition: transform .25s ease;
}

.announcement-bar a:hover span {
  transform: translate(3px, -3px);
}

/* Header */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  min-height: var(--header-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 13px max(32px, calc((100% - var(--max-width)) / 2));
  background: rgba(7, 17, 13, .88);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  flex: 0 0 auto;
}

.brand-logo {
  width: 43px;
  height: 43px;
  border-radius: 11px;
  object-fit: cover;
  background: var(--panel-2);
  border: 1px solid var(--border);
}

.brand-copy {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
}

.brand-copy strong {
  font-family: "Inter", sans-serif;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -1px;
}

.brand-copy strong span {
  color: var(--green);
}

.brand-copy small {
  margin-top: 5px;
  color: var(--muted);
  font-family: "Inter", sans-serif;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 2.3px;
}

.main-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(15px, 2vw, 28px);
}

.main-nav a,
.footer-links a {
  color: #c4d0c6;
  font-size: 13px;
  transition: color .25s ease;
}

.main-nav a:hover,
.footer-links a:hover {
  color: var(--green);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.language-toggle,
.theme-toggle {
  height: 38px;
  min-width: 38px;
  padding: 0 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: transparent;
  cursor: pointer;
  font-size: 12px;
  transition: border-color .25s ease, background .25s ease;
}

.language-toggle:hover,
.theme-toggle:hover {
  background: var(--panel-2);
  border-color: var(--border-green);
}

.button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  min-height: 42px;
  padding: 10px 17px;
  border: 1px solid transparent;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
  cursor: pointer;
  transition:
    transform .3s var(--ease),
    background .3s ease,
    border-color .3s ease,
    box-shadow .3s ease,
    color .3s ease;
}

.button:hover {
  transform: translateY(-3px);
}

.button span {
  display: inline-block;
  transition: transform .3s var(--ease);
}

.button:hover span {
  transform: translate(3px, -2px);
}

.button-primary {
  background: var(--green);
  color: #0a1608;
  border-color: var(--green);
  box-shadow: 0 5px 20px rgba(183, 243, 74, .08);
}

.button-primary:hover {
  background: #c7ff66;
  box-shadow: 0 10px 35px rgba(183, 243, 74, .2);
}

.button-outline {
  background: transparent;
  color: var(--text);
  border-color: var(--border);
}

.button-outline:hover {
  border-color: var(--green);
  background: var(--green-soft);
}

.button-ghost {
  background: rgba(255, 255, 255, .025);
  border-color: var(--border);
  color: var(--text);
}

.button-ghost:hover {
  border-color: var(--border-green);
  background: var(--panel-2);
}

.button-large {
  min-height: 51px;
  padding: 14px 21px;
  border-radius: 12px;
  font-size: 14px;
}

.menu-toggle {
  display: none;
  width: 42px;
  height: 42px;
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--panel);
  cursor: pointer;
}

.menu-toggle span {
  display: block;
  width: 18px;
  height: 2px;
  margin: 4px auto;
  background: var(--text);
  transition: transform .25s ease, opacity .25s ease;
}

/* Hero */

.hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.03fr .97fr;
  align-items: center;
  gap: 30px;
  min-height: 650px;
  padding-top: 76px;
  padding-bottom: 84px;
}

.hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: 28px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--green);
  font-family: "Inter", sans-serif;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.6px;
}

.eyebrow-icon {
  display: inline-grid;
  place-items: center;
  width: 23px;
  height: 23px;
  border: 1px solid var(--border-green);
  border-radius: 7px;
  font-size: 13px;
}

.hero h1 {
  margin-top: 25px;
  font-size: clamp(42px, 4.5vw, 67px);
  font-weight: 700;
  line-height: 1.22;
  letter-spacing: -1.6px;
}

.hero-highlight {
  color: var(--green);
}

.hero-last-line {
  color: #f2f7f0;
}

.hero-description {
  max-width: 520px;
  margin-top: 24px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.95;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.play-icon {
  display: inline-grid;
  place-items: center;
  width: 22px;
  height: 22px;
  border: 1px solid var(--border);
  border-radius: 50%;
  font-size: 8px;
}

.hero-trust {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 38px;
}

.trust-avatars {
  display: flex;
  padding-left: 3px;
}

.trust-avatars span {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  margin-left: -3px;
  border: 2px solid var(--bg);
  border-radius: 50%;
  background: #243c2b;
  color: var(--green);
  font-family: "Inter", sans-serif;
  font-size: 10px;
  font-weight: 800;
}

.trust-avatars span:nth-child(2) {
  background: #35442a;
}

.trust-avatars span:nth-child(3) {
  background: #263c39;
}

.trust-avatars span:nth-child(4) {
  background: var(--green);
  color: #10200c;
}

.hero-trust strong {
  display: block;
  font-size: 12px;
  font-weight: 600;
}

.hero-trust p {
  margin-top: 2px;
  color: var(--muted-2);
  font-size: 11px;
}

/* Hero visual */

.hero-visual {
  position: relative;
  min-width: 0;
  min-height: 470px;
  display: grid;
  place-items: center;
  isolation: isolate;
}

.visual-grid {
  position: absolute;
  z-index: -2;
  inset: 8% 1% 7%;
  opacity: .4;
  background-image:
    linear-gradient(rgba(183, 243, 74, .07) 1px, transparent 1px),
    linear-gradient(90deg, rgba(183, 243, 74, .07) 1px, transparent 1px);
  background-size: 36px 36px;
  mask-image: radial-gradient(ellipse at center, black 10%, transparent 72%);
}

.visual-orb {
  position: absolute;
  z-index: -1;
  border-radius: 50%;
  filter: blur(1px);
  pointer-events: none;
}

.orb-one {
  top: 12%;
  left: 17%;
  width: 260px;
  height: 260px;
  background: radial-gradient(circle, rgba(119, 202, 48, .17), transparent 70%);
  animation: orb-breathe 7s ease-in-out infinite alternate;
}

.orb-two {
  right: 0;
  bottom: 6%;
  width: 220px;
  height: 220px;
  background: radial-gradient(circle, rgba(39, 114, 78, .22), transparent 70%);
  animation: orb-breathe 8s ease-in-out infinite alternate-reverse;
}

.preview-window {
  overflow: hidden;
  border: 1px solid rgba(235, 255, 235, .2);
  border-radius: 15px;
  background: #f3f0e8;
  box-shadow: 0 30px 100px rgba(0, 0, 0, .4);
}

.preview-main {
  position: relative;
  z-index: 2;
  width: min(90%, 425px);
  transform: rotate(-2deg);
  animation: preview-float 7s ease-in-out infinite;
}

.preview-toolbar {
  height: 33px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 0 12px;
  background: #f8f8f4;
  border-bottom: 1px solid #e5e6dc;
  color: #697367;
  font-family: "Inter", sans-serif;
  font-size: 8px;
}

.window-dots {
  display: flex;
  gap: 4px;
}

.window-dots i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #d5d9d0;
}

.window-dots i:first-child {
  background: #9acb72;
}

.toolbar-lock {
  font-size: 14px;
}

.preview-site {
  position: relative;
  min-height: 365px;
  overflow: hidden;
  color: #263d2b;
  background: #e9eadf;
}

.preview-site-nav {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18px 23px;
}

.mini-brand {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: "Inter", sans-serif;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.mini-brand i {
  width: 12px;
  height: 12px;
  border-radius: 50% 50% 3px 50%;
  background: #62855a;
}

.mini-nav-lines {
  display: flex;
  gap: 10px;
}

.mini-nav-lines i {
  width: 22px;
  height: 3px;
  border-radius: 3px;
  background: #a3ac9c;
}

.preview-site-hero {
  position: relative;
  z-index: 2;
  padding: 24px 24px 15px;
}

.mini-kicker {
  color: #607a5e;
  font-family: "Inter", sans-serif;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.mini-headline {
  margin-top: 12px;
  font-family: "Inter", sans-serif;
  font-size: clamp(30px, 3vw, 43px);
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -2px;
}

.mini-headline span {
  color: #79916b;
}

.preview-site-hero p {
  margin-top: 10px;
  color: #687567;
  font-family: "Inter", sans-serif;
  font-size: 9px;
}

.mini-button {
  display: inline-block;
  margin-top: 14px;
  padding: 9px 12px;
  background: #293e2c;
  color: white;
  font-family: "Inter", sans-serif;
  font-size: 8px;
}

.preview-site-image {
  position: absolute;
  right: -4px;
  bottom: 30px;
  width: 46%;
  height: 165px;
  overflow: hidden;
  background: linear-gradient(145deg, #d2d8bf, #a9b99a);
  clip-path: polygon(17% 0, 100% 0, 100% 100%, 0 100%, 0 23%);
}

.image-shape {
  position: absolute;
  border-radius: 50%;
}

.shape-a {
  width: 140px;
  height: 140px;
  right: -15px;
  bottom: -45px;
  background: #607f5a;
}

.shape-b {
  width: 100px;
  height: 120px;
  right: 48px;
  bottom: -24px;
  border-radius: 50% 50% 0 0;
  background: #b5c4a3;
  transform: rotate(18deg);
}

.shape-c {
  width: 45px;
  height: 100px;
  right: 90px;
  bottom: -15px;
  border-radius: 50% 50% 0 0;
  background: #e3e5d7;
  transform: rotate(-20deg);
}

.image-sun {
  position: absolute;
  top: 19px;
  right: 29px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #e9e6ca;
}

.preview-site-bottom {
  position: absolute;
  right: 22px;
  bottom: 12px;
  left: 22px;
  display: flex;
  justify-content: space-between;
  color: #657663;
  font-family: "Inter", sans-serif;
  font-size: 7px;
  letter-spacing: 1px;
}

.preview-secondary {
  position: absolute;
  z-index: 1;
  right: -1%;
  bottom: 3%;
  width: 190px;
  padding: 9px;
  background: #f8f4ec;
  transform: rotate(8deg);
  animation: secondary-float 8s ease-in-out infinite;
}

.secondary-cover {
  height: 105px;
  background:
    radial-gradient(ellipse at 70% 25%, #e5c58c 0 13%, transparent 14%),
    linear-gradient(145deg, transparent 35%, #8a9a6b 36% 62%, #354f39 63%),
    linear-gradient(40deg, #d9d5b7, #b4c7a0);
}

.secondary-lines {
  padding: 12px 6px 8px;
}

.secondary-lines i {
  display: block;
  height: 4px;
  margin: 5px 0;
  border-radius: 4px;
  background: #d8d9cf;
}

.secondary-lines i:first-child {
  width: 60%;
  height: 7px;
  background: #526b4d;
}

.secondary-lines i:last-child {
  width: 42%;
}

.secondary-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 2px 6px 7px;
  color: #657763;
  font-family: "Inter", sans-serif;
  font-size: 7px;
  letter-spacing: .7px;
}

.secondary-footer b {
  color: #314a34;
  font-size: 14px;
}

.floating-label {
  position: absolute;
  z-index: 5;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px 15px;
  border: 1px solid rgba(223, 250, 220, .14);
  border-radius: 12px;
  background: rgba(15, 30, 20, .92);
  box-shadow: 0 15px 40px rgba(0, 0, 0, .25);
  backdrop-filter: blur(14px);
  font-size: 11px;
}

.floating-label-top {
  top: 7%;
  right: 2%;
  animation: label-float 5s ease-in-out infinite;
}

.floating-label-bottom {
  bottom: 10%;
  left: -1%;
  animation: label-float 6s ease-in-out infinite reverse;
}

.floating-check {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 15px;
}

.floating-label-bottom strong,
.floating-label-bottom small {
  display: block;
}

.floating-label-bottom strong {
  font-size: 11px;
}

.floating-label-bottom small {
  margin-top: 1px;
  color: var(--muted);
  font-size: 9px;
}

.hero-visual-caption {
  position: absolute;
  right: 0;
  bottom: -12px;
  color: var(--muted-2);
  font-family: "Inter", sans-serif;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.hero-visual-caption span {
  margin-left: 8px;
  color: var(--green);
}

.hero-bottom-line {
  position: absolute;
  right: 0;
  bottom: 26px;
  left: 0;
  display: flex;
  justify-content: space-between;
  padding-top: 18px;
  border-top: 1px solid var(--border);
  color: var(--muted-2);
  font-family: "Inter", sans-serif;
  font-size: 9px;
  letter-spacing: 1.2px;
}

.hero-bottom-line a {
  color: var(--text);
  font-family: "Hind Siliguri", sans-serif;
  font-size: 11px;
  letter-spacing: 0;
}

.hero-bottom-line a span {
  margin-left: 5px;
  color: var(--green);
}

/* Trust strip */

.trust-strip {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: rgba(255, 255, 255, .012);
}

.trust-strip-inner {
  min-height: 92px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.trust-strip-inner > span {
  color: var(--muted);
  font-size: 12px;
}

.trust-pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10px;
}

.trust-pills span {
  padding: 7px 11px;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: #c3d0c5;
  font-family: "Inter", sans-serif;
  font-size: 10px;
}

/* Section headings */

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 35px;
  margin-bottom: 43px;
}

.section-heading h2,
.pricing-intro h2,
.contact-panel h2 {
  margin-top: 18px;
  font-size: clamp(34px, 4vw, 51px);
  font-weight: 700;
  line-height: 1.27;
  letter-spacing: -1px;
}

.muted-heading {
  color: #8fa294;
}

.section-heading > p {
  max-width: 390px;
  padding-bottom: 5px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.9;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 6px;
  color: var(--green);
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
}

.text-link span {
  transition: transform .25s ease;
}

.text-link:hover span {
  transform: translate(3px, -3px);
}

/* Category cards */

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.category-card {
  position: relative;
  min-height: 260px;
  overflow: hidden;
  padding: 25px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: linear-gradient(145deg, rgba(18, 35, 24, .95), rgba(10, 22, 15, .9));
  transition: transform .4s var(--ease), border-color .3s ease, background .3s ease;
}

.category-card:hover {
  transform: translateY(-7px);
  border-color: var(--border-green);
  background: linear-gradient(145deg, #172c1d, #0d1b12);
}

.category-icon {
  position: relative;
  z-index: 2;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--border-green);
  border-radius: 13px;
  background: var(--green-soft);
  color: var(--green);
  font-size: 23px;
  transition: transform .35s var(--ease), background .3s ease;
}

.category-card:hover .category-icon {
  transform: rotate(-8deg) scale(1.06);
  background: rgba(183, 243, 74, .18);
}

.category-count {
  position: absolute;
  top: 28px;
  right: 23px;
  color: #718476;
  font-family: "Inter", sans-serif;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 1.1px;
}

.category-card h3 {
