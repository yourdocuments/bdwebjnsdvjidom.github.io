/* Footer */

.site-footer {
  border-top: 1px solid var(--border);
  background: #050c08;
}

.footer-main {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1.5fr;
  align-items: center;
  gap: 35px;
  padding-top: 40px;
  padding-bottom: 38px;
}

.footer-main > p {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.9;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12px 22px;
}

.footer-links a {
  font-size: 11px;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 15px;
  padding-top: 19px;
  padding-bottom: 22px;
  border-top: 1px solid var(--border);
  color: var(--muted-2);
  font-family: "Inter", "Hind Siliguri", sans-serif;
  font-size: 9px;
}

.footer-bottom > span:nth-child(2) {
  letter-spacing: 1px;
}

.footer-bottom b {
  color: var(--green);
}

.footer-bottom a {
  color: #c0cfc1;
  font-family: "Hind Siliguri", sans-serif;
  font-size: 10px;
}

/* Reveal animation — JS adds .is-visible */

.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition:
    opacity .75s var(--ease),
    transform .75s var(--ease);
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.category-card.reveal:nth-child(2),
.website-card.reveal:nth-child(2),
.process-card.reveal:nth-child(2) {
  transition-delay: .09s;
}

.category-card.reveal:nth-child(3),
.website-card.reveal:nth-child(3),
.process-card.reveal:nth-child(3) {
  transition-delay: .17s;
}

.category-card.reveal:nth-child(5) {
  transition-delay: .08s;
}

.category-card.reveal:nth-child(6) {
  transition-delay: .16s;
}

/* Keyframes */

@keyframes preview-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-12px) rotate(-1deg); }
}

@keyframes secondary-float {
  0%, 100% { transform: translateY(0) rotate(8deg); }
  50% { transform: translateY(-15px) rotate(5deg); }
}

@keyframes label-float {
  0%, 100% { translate: 0 0; }
  50% { translate: 0 -8px; }
}

@keyframes orb-breathe {
  from { transform: scale(.92); opacity: .65; }
  to { transform: scale(1.12); opacity: 1; }
}

/* Light theme — JS toggles body.light-theme */

body.light-theme {
  --bg: #f5f8f3;
  --bg-soft: #edf2e9;
  --panel: #ffffff;
  --panel-2: #eef4e9;
  --panel-3: #e5eddf;
  --text: #17251a;
  --muted: #596a5c;
  --muted-2: #718174;
  --border: rgba(31, 65, 37, .13);
  --border-green: rgba(88, 135, 43, .35);
  --green: #5e951e;
  --green-2: #477b14;
  --green-soft: rgba(94, 149, 30, .10);
  background: var(--bg);
}

body.light-theme::before {
  opacity: .12;
}

body.light-theme .site-header {
  background: rgba(245, 248, 243, .9);
}

body.light-theme .announcement-bar {
  background: #e8f0e3;
  color: #445745;
}

body.light-theme .hero-last-line {
  color: #1b2a1e;
}

body.light-theme .hero-highlight {
  color: #568b1c;
}

body.light-theme .category-card,
body.light-theme .pricing-card,
body.light-theme .process-card,
body.light-theme .contact-panel {
  background: #fff;
}

body.light-theme .category-card:hover {
  background: #f8fbf5;
}

body.light-theme .pricing-card-featured {
  background: linear-gradient(145deg, #f2f8e9, #fff);
}

body.light-theme .category-card-featured {
  background: linear-gradient(145deg, #eaf4dd, #f8fbf5);
}

body.light-theme .website-section,
body.light-theme .process-section,
body.light-theme .trust-strip {
  background: rgba(50, 90, 40, .025);
}

body.light-theme .site-footer {
  background: #eaf0e7;
}

body.light-theme .site-footer .brand-copy strong {
  color: #18281a;
}

body.light-theme .trust-avatars span {
  border-color: var(--bg);
}

body.light-theme .section-heading h2,
body.light-theme .pricing-intro h2,
body.light-theme .contact-panel h2,
body.light-theme .cta-content h2 {
  color: #18271b;
}

body.light-theme .muted-heading {
  color: #617763;
}

body.light-theme .cta-section {
  background:
    radial-gradient(ellipse at 85% 10%, rgba(94, 149, 30, .12), transparent 42%),
    linear-gradient(130deg, #e7f0df, #f6f9f3);
}

body.light-theme .cta-stamp {
  color: #568b1c;
}

body.light-theme .button-outline {
  color: var(--text);
}

body.light-theme .feature-list li {
  color: #465747;
}

body.light-theme .features-heading {
  color: #26382a;
}

body.light-theme .pricing-card-featured .popular-ribbon {
  color: #0b1609;
}

body.light-theme .preview-window {
  box-shadow: 0 25px 70px rgba(25, 50, 25, .18);
}

/* Responsive */

@media (min-width: 1500px) {
  .hero {
    min-height: 720px;
  }

  .hero h1 {
    font-size: 70px;
  }
}

@media (max-width: 1180px) {
  :root {
    --header-height: 74px;
  }

  .site-header {
    gap: 15px;
  }

  .main-nav {
    gap: 15px;
  }

  .main-nav a {
    font-size: 12px;
  }

  .header-sell {
    display: none;
  }

  .hero {
    min-height: 600px;
    gap: 15px;
  }

  .hero h1 {
    font-size: clamp(42px, 5vw, 58px);
  }

  .preview-main {
    width: 88%;
  }

  .category-card {
    padding: 21px;
  }

  .pricing-card {
    padding: 25px 20px 22px;
  }
}

@media (max-width: 920px) {
  .section-shell {
    width: min(100% - 44px, var(--max-width));
  }

  .site-header {
    padding-inline: 22px;
  }

  .menu-toggle {
    display: block;
    order: 3;
  }

  .header-actions {
    margin-left: auto;
  }

  .main-nav {
    position: fixed;
    top: calc(var(--header-height) + 37px);
    right: 0;
    left: 0;
    display: none;
    align-items: stretch;
    flex-direction: column;
    gap: 0;
    padding: 15px 22px 25px;
    border-bottom: 1px solid var(--border);
    background: rgba(7, 17, 13, .98);
    box-shadow: 0 25px 40px rgba(0, 0, 0, .2);
  }

  .main-nav.is-open {
    display: flex;
    animation: menu-enter .3s var(--ease) both;
  }

  .main-nav a {
    padding: 13px 5px;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }

  body.light-theme .main-nav {
    background: rgba(245, 248, 243, .98);
  }

  .hero {
    grid-template-columns: 1fr 1fr;
    min-height: 570px;
    padding-top: 65px;
  }

  .hero h1 {
    font-size: clamp(37px, 5vw, 49px);
    letter-spacing: -1.3px;
  }

  .hero-description {
    font-size: 14px;
  }

  .hero-visual {
    min-height: 420px;
  }

  .preview-site {
    min-height: 325px;
  }

  .preview-secondary {
    width: 145px;
  }

  .floating-label {
    padding: 9px 11px;
  }

  .floating-label-top {
    right: 0;
  }

  .floating-label-bottom {
    left: 0;
  }

  .trust-strip-inner {
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    padding-block: 20px;
  }

  .trust-pills {
    justify-content: flex-start;
  }

  .category-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .website-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .website-card:last-child {
    grid-column: 1 / -1;
  }

  .website-card:last-child .website-preview {
    min-height: 250px;
  }

  .pricing-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pricing-card:last-child {
    grid-column: 1 / -1;
  }

  .pricing-card:last-child .feature-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .plan-price strong {
    font-size: 42px;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .process-card {
    min-height: 230px;
  }

  .cta-section {
    padding: 50px 40px;
  }

  .cta-stamp {
    width: 160px;
    height: 160px;
    flex-basis: 160px;
  }

  .cta-stamp strong {
    font-size: 22px;
  }

  .footer-main {
    grid-template-columns: 1fr 1fr;
  }

  .footer-links {
    grid-column: 1 / -1;
    justify-content: flex-start;
  }
}

@keyframes menu-enter {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 600px) {
  :root {
    --header-height: 66px;
  }

  .section-shell {
    width: calc(100% - 36px);
